# ============================================================================
# OpenWA — Evolution Go (stack dedicada) — copie para .env e preencha
# ============================================================================
#   cp evolution-go/.env.example evolution-go/.env
#   # gere uma chave forte:
#   openssl rand -hex 32
# ============================================================================

# --- Obrigatórios -----------------------------------------------------------

# Chave global da API do Evolution Go. Usada pelo OpenWA para CRIAR/REMOVER
# instâncias. O token por instância é devolvido pelo próprio motor.
EVOLUTION_GO_API_KEY=troque-por-openssl-rand-hex-32

# Senha do PostgreSQL desta stack.
EVO_POSTGRES_PASSWORD=troque-esta-senha

# --- Opcionais (defaults do compose) ----------------------------------------

# TZ=America/Sao_Paulo
# EVO_POSTGRES_USER=postgres
# EVO_CLIENT_NAME=openwa
# EVO_SAVE_MESSAGES=true
# EVO_WADEBUG=INFO
# EVO_CONNECT_ON_STARTUP=true
# EVO_MAX_FILE_SIZE=52428800
# EVO_WEBHOOK_GLOBAL_ENABLED=false

# --- Profile "debug" (publica a porta SÓ em loopback) -----------------------
# EVO_DEBUG_BIND=127.0.0.1
# EVO_DEBUG_PORT=7001
